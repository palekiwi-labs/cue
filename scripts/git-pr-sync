#!/usr/bin/env bash
# Synchronize GitHub PR metadata into native Git config (branch.<name>.*).
#
# Storage contract:
#   branch.<name>.base          - Target base branch name (e.g., master, main)
#   branch.<name>.pr            - Pull request number (e.g., 123)
#   branch.<name>.behindBase    - "true" if origin/<base> requires integration,
#                                 absent when current or histories are unrelated
#   branch.<name>.behindDefault - "true" if origin/<default> requires integration,
#                                 absent when current or histories are unrelated
#
# Exit code is always 0 to ensure post-checkout/post-merge hook safety.

set -u

quiet=false
case "${1:-}" in
  -q|--quiet)
    quiet=true
    ;;
esac

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ -z "$branch" ]; then
  exit 0
fi

sync_behind_status() {
  local config_key=$1
  local upstream_ref=$2
  local label=$3

  # Unrelated histories (e.g. orphan branches) are not "behind".
  if ! git merge-base HEAD "$upstream_ref" >/dev/null 2>&1; then
    git config --unset "$config_key" 2>/dev/null || true
    return 0
  fi

  if git merge-base --is-ancestor "$upstream_ref" HEAD 2>/dev/null; then
    git config --unset "$config_key" 2>/dev/null || true
  else
    git config "$config_key" "true"
    "$quiet" || printf "\033[33mHEAD is behind %s\033[0m\n" "$label" >&2
  fi
}

refresh_behind_base() {
  local base=$1
  local default_branch=$2
  local origin_ref="origin/$base"

  if [ "$base" != "$default_branch" ]; then
    git fetch origin "$base" --quiet 2>/dev/null || return 0
  fi

  sync_behind_status \
    "branch.${branch}.behindBase" \
    "$origin_ref" \
    "base branch '$base'"
}

refresh_cached_behind_base() {
  local default_branch=$1
  local cached_base

  cached_base=$(git config "branch.${branch}.base" 2>/dev/null || true)
  if [ -n "$cached_base" ]; then
    refresh_behind_base "$cached_base" "$default_branch"
  fi
}

# Resolve default branch (pure git, fast & offline).
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default_branch=${default_branch#origin/}
if [ -z "$default_branch" ]; then
  git remote set-head origin --auto >/dev/null 2>&1 || true
  default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  default_branch=${default_branch#origin/}
fi

if [ -n "$default_branch" ]; then
  origin_default="origin/$default_branch"
  if git fetch origin "$default_branch" --quiet 2>/dev/null; then
    sync_behind_status \
      "branch.${branch}.behindDefault" \
      "$origin_default" \
      "default branch '$default_branch'"
  fi
elif git remote get-url origin >/dev/null 2>&1; then
  git config --unset "branch.${branch}.behindDefault" 2>/dev/null || true
  "$quiet" || printf "\033[33mCould not resolve default branch (origin/HEAD unset); no drift signal\033[0m\n" >&2
fi

if ! command -v gh >/dev/null 2>&1; then
  refresh_cached_behind_base "$default_branch"
  exit 0
fi

err_file=$(mktemp)
trap 'rm -f "$err_file"' EXIT

pr_data=$(gh pr view --json number,baseRefName --jq '.number, .baseRefName' 2>"$err_file")
gh_status=$?
err_text=$(<"$err_file")

if [ "$gh_status" -eq 0 ] && [ -n "$pr_data" ]; then
  mapfile -t pr_fields <<<"$pr_data"
  pr_number=${pr_fields[0]:-}
  base_branch=${pr_fields[1]:-}

  if [ -n "$pr_number" ] && [ -n "$base_branch" ]; then
    git config "branch.${branch}.base" "$base_branch"
    git config "branch.${branch}.pr" "$pr_number"

    refresh_behind_base "$base_branch" "$default_branch"
    "$quiet" || printf "\033[32mUpdated PR info: #%s (base: %s)\033[0m\n" "$pr_number" "$base_branch" >&2
  fi
else
  if printf '%s\n' "$err_text" | grep -qiE "no (open )?pull requests? found|could not resolve to a PullRequest"; then
    git config --unset "branch.${branch}.base" 2>/dev/null || true
    git config --unset "branch.${branch}.pr" 2>/dev/null || true
    git config --unset "branch.${branch}.behindBase" 2>/dev/null || true
    "$quiet" || printf "\033[32mCleared PR info (not on a PR branch)\033[0m\n" >&2
  else
    refresh_cached_behind_base "$default_branch"
  fi
fi

exit 0
